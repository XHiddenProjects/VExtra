{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vextra Studio",
  "version": "3.12.0",
  "identifier": "studio.vextra.app",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vextra Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Web development and 2D/3D game creation",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/server/*"
    ],
    "windows": {
      "wix": {
        "fragmentPaths": [
          "./windows/fragments/data-removal.wxs"
        ],
        "componentRefs": [
          "VextraDataRemoval"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/XHiddenProjects/VExtraStudio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
