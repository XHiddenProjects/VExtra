{
  "name": "vextra-studio",
  "productName": "Vextra Studio",
  "version": "3.7.0",
  "description": "Vextra Studio \u2013 professional web development and 2D/3D game creation in one workspace (Tauri v2)",
  "author": "XHiddenProjects",
  "license": "AGPL-3.0-only",
  "scripts": {
    "postinstall": "node scripts/vendor.js",
    "start": "tauri dev",
    "build": "node scripts/build-server.js && tauri build",
    "build:win": "node scripts/build-server.js --target win && tauri build --bundles nsis,msi",
    "build:linux": "node scripts/build-server.js --target linux && tauri build --bundles deb,appimage",
    "build:mac": "node scripts/build-server.js --target mac && tauri build --bundles app,dmg",
    "tauri": "tauri",
    "vendor": "node scripts/vendor.js",
    "web": "node scripts/dev-server.js",
    "server": "node server/server.js",
    "lfs:setup": "node scripts/setup-lfs.js",
    "test": "node scripts/selftest.js",
    "icons": "tauri icon app-icon.png",
    "clean": "node scripts/uninstall.js --mode=clean --auto",
    "autoclean": "node scripts/uninstall.js --mode=clean --auto",
    "uninstall": "node scripts/uninstall.js",
    "uninstall:auto": "node scripts/uninstall.js --mode=full --auto",
    "build:server": "node scripts/build-server.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "latest",
    "ace-builds": "latest",
    "esbuild": "latest",
    "postject": "latest",
    "sql.js": "latest",
    "three": "latest"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    }
  },
  "allowScripts": {
    "esbuild": true
  }
}
