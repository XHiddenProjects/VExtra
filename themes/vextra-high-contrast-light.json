{
 "id": "vextra-high-contrast-light",
 "name": "High Contrast Light",
 "type": "light",
 "colors": {
  "bg": "#ffffff",
  "bg2": "#f5f5f5",
  "bg3": "#e6e6e6",
  "border": "#000000",
  "text": "#000000",
  "muted": "#2b2b2b",
  "accent": "#0000cc",
  "accentFg": "#ffffff"
 },
 "editor": {
  "rules": [
   {
    "token": "comment",
    "foreground": "3a5a2a",
    "fontStyle": "italic"
   },
   {
    "token": "keyword",
    "foreground": "0000cc"
   },
   {
    "token": "string",
    "foreground": "8a0000"
   },
   {
    "token": "number",
    "foreground": "005a00"
   },
   {
    "token": "type",
    "foreground": "00598a"
   }
  ]
 }
}
